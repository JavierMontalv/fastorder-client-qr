# ── client-qr — Variables de producción (Vercel) ─────────────────────────
# Configura estas variables en: Vercel Dashboard → Project → Settings → Environment Variables
# NO uses rutas relativas (/api) — Vercel no tiene proxy al backend.
# Usa la URL absoluta del backend (EC2 / Railway / Render / Fly.io).

VITE_API_URL=https://api.tudominio.com/api
VITE_ASSETS_URL=https://api.tudominio.com
VITE_VAPID_PUBLIC_KEY=tu_vapid_public_key_aqui
